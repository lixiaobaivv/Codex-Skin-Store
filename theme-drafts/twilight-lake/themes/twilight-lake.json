{
  "$schema": "../../../schemas/theme-v1.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "displayName": "Twilight Lake",
  "codeThemeId": "twilight-lake",
  "category": "风景",
  "description": "暮色湖面、双山剪影与深色玻璃面板组成的沉浸主题",
  "author": "nisiwei-git",
  "variant": "dark",
  "previewImage": "../previews/twilight-lake.png",
  "theme": {
    "accent": "#4AA8FF",
    "ink": "#EDF5FF",
    "surface": "#111B28",
    "contrast": 68,
    "opaqueWindows": false,
    "backgroundImage": "../backgrounds/twilight-lake.png",
    "backgroundFocus": { "x": 50, "y": 48 },
    "visualIntensity": "immersive",
    "effects": {
      "ambient": "particles",
      "intensity": "subtle"
    },
    "backgroundImageOpacity": 1,
    "backgroundImageBlur": 0,
    "fonts": {
      "ui": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", sans-serif",
      "display": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", sans-serif",
      "code": "\"SFMono-Regular\", \"Cascadia Code\", monospace"
    },
    "semanticColors": {
      "diffAdded": "#55D69A",
      "diffRemoved": "#FF7D8B",
      "skill": "#8D9CFF"
    }
  },
  "home": {
    "brand": "Twilight Lake",
    "eyebrow": "BLUE HOUR FOCUS",
    "badge": "暮色湖畔",
    "title": "今晚，我们构建什么？",
    "subtitle": "让沉静的湖面承接思路，让远山替你隔开干扰。",
    "footerNote": "Build beyond the horizon.",
    "composerHint": "告诉 Codex 今晚要完成什么",
    "tags": ["暮色", "湖景", "沉浸"],
    "sidebarLabels": {
      "newTask": "新建任务",
      "scheduled": "已安排",
      "plugins": "插件",
      "settings": "设置"
    },
    "quickActions": [
      {
        "icon": "</>",
        "title": "探索代码",
        "description": "看清结构和关键流程",
        "prompt": "请概览当前代码库的结构、关键模块和主要流程。"
      },
      {
        "icon": "+",
        "title": "构建功能",
        "description": "实现新的能力与体验",
        "prompt": "请基于当前项目实现一个新功能，并完成必要验证。"
      },
      {
        "icon": "✓",
        "title": "审查代码",
        "description": "发现缺陷与改进空间",
        "prompt": "请审查当前代码，优先指出缺陷、风险和缺失测试。"
      },
      {
        "icon": "!",
        "title": "修复问题",
        "description": "定位根因并验证修复",
        "prompt": "请诊断当前问题，修复根因并验证结果。"
      }
    ]
  },
  "copy": {
    "title": "Codex Twilight Lake",
    "replacePlaceholders": {
      "Ask Codex": "告诉 Codex 今晚要完成什么",
      "Ask Codex anything": "告诉 Codex 今晚要完成什么"
    }
  }
}
